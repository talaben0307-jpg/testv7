-- [[
--   Standalone FE Invisible + Hitbox (Fixed Camera & Clones)
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local parentGui = (gethui and gethui()) or CoreGui

if _G.StandaloneFEGhostCleanup then
    pcall(_G.StandaloneFEGhostCleanup)
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "StandaloneFEGhostGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.Parent = parentGui

-- Nút nổi
local FloatBtn = Instance.new("TextButton")
FloatBtn.Name = "GhostButton"
FloatBtn.Parent = ScreenGui
FloatBtn.Position = UDim2.new(0, 150, 0, 160)
FloatBtn.Size = UDim2.fromOffset(56, 56)
FloatBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 28)
FloatBtn.BackgroundTransparency = 0.15
FloatBtn.Font = Enum.Font.GothamBold
FloatBtn.Text = "👻"
FloatBtn.TextSize = 22
FloatBtn.TextColor3 = Color3.fromRGB(0, 229, 255)
FloatBtn.AutoButtonColor = false
FloatBtn.ZIndex = 30

local UICorner = Instance.new("UICorner", FloatBtn)
UICorner.CornerRadius = UDim.new(0, 16)
local UIStroke = Instance.new("UIStroke", FloatBtn)
UIStroke.Color = Color3.fromRGB(0, 229, 255)
UIStroke.Thickness = 1.5

-- Kéo thả nút
local dragging, moved, startInput, startPos = false, false, nil, nil
FloatBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        moved = false
        startInput = input.Position
        startPos = FloatBtn.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - startInput
        if delta.Magnitude > 5 then moved = true end
        if moved then
            FloatBtn.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local isGhostActive = false
local RealChar, FakeChar = nil, nil
local loopConn = nil

-- Hàm xóa sạch clone cũ để fix lỗi tạo nhiều bản sao
local function cleanOldClones()
    for _, v in ipairs(Workspace:GetChildren()) do
        if v.Name == "FE_GhostClone_" .. LocalPlayer.Name then
            v:Destroy()
        end
    end
end

local function activateFEInvisible()
    if isGhostActive or not LocalPlayer.Character then return end
    isGhostActive = true
    
    cleanOldClones() 
    
    RealChar = LocalPlayer.Character
    RealChar.Archivable = true
    
    FakeChar = RealChar:Clone()
    FakeChar.Name = "FE_GhostClone_" .. LocalPlayer.Name
    FakeChar.Parent = Workspace
    
    -- Xóa script thừa trong bản clone
    for _, v in ipairs(FakeChar:GetDescendants()) do
        if v:IsA("LocalScript") or v:IsA("Script") then
            v:Destroy()
        end
    end

    -- Chuyển quyền điều khiển và gỡ kẹt Camera
    LocalPlayer.Character = FakeChar
    task.delay(0.1, function()
        if Workspace.CurrentCamera then
            Workspace.CurrentCamera.CameraSubject = FakeChar:FindFirstChild("Humanoid")
        end
    end)
    
    loopConn = RunService.Heartbeat:Connect(function()
        if RealChar and FakeChar and RealChar:FindFirstChild("HumanoidRootPart") and FakeChar:FindFirstChild("HumanoidRootPart") then
            -- Kéo hitbox thật theo bản sao
            RealChar.HumanoidRootPart.CFrame = FakeChar.HumanoidRootPart.CFrame
            RealChar.HumanoidRootPart.Velocity = Vector3.zero
            
            -- Đưa vào vòng lặp để liên tục ẩn các hiệu ứng, khối màu đen/vàng mới sinh ra
            for _, v in ipairs(RealChar:GetDescendants()) do
                if v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture") then
                    if v.Name ~= "HumanoidRootPart" then
                        v.Transparency = 1
                        v.CanCollide = false
                    end
                end
            end
            
            -- Liên tục ép camera theo Clone nếu bị game giành lại
            if Workspace.CurrentCamera.CameraSubject ~= FakeChar:FindFirstChild("Humanoid") then
                Workspace.CurrentCamera.CameraSubject = FakeChar:FindFirstChild("Humanoid")
            end
        else
            deactivateFEInvisible()
        end
    end)
    
    UIStroke.Color = Color3.fromRGB(255, 70, 90)
    FloatBtn.TextColor3 = Color3.fromRGB(255, 70, 90)
end

function deactivateFEInvisible()
    if not isGhostActive then return end
    isGhostActive = false
    
    if loopConn then loopConn:Disconnect() end
    
    if RealChar and RealChar.Parent then
        LocalPlayer.Character = RealChar
        task.delay(0.1, function()
            if Workspace.CurrentCamera then
                Workspace.CurrentCamera.CameraSubject = RealChar:FindFirstChild("Humanoid")
            end
        end)
        
        -- Khôi phục hiện hình
        for _, v in ipairs(RealChar:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture") then
                if v.Name ~= "HumanoidRootPart" then
                    v.Transparency = 0
                    v.CanCollide = true
                end
            end
        end
    end
    
    cleanOldClones()
    
    UIStroke.Color = Color3.fromRGB(0, 229, 255)
    FloatBtn.TextColor3 = Color3.fromRGB(0, 229, 255)
end

FloatBtn.Activated:Connect(function()
    if not moved then
        if isGhostActive then
            deactivateFEInvisible()
        else
            activateFEInvisible()
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    if isGhostActive then
        deactivateFEInvisible()
    end
end)

_G.StandaloneFEGhostCleanup = function()
    deactivateFEInvisible()
    if ScreenGui then ScreenGui:Destroy() end
end
